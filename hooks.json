{
  "description": "Codex reads this as ~/.codex/hooks.json, which README.md's Setup renders with the path of the clone",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "\"$PROCESS/scripts/git-c-allow.py\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
